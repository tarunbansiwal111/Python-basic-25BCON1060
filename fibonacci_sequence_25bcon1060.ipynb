      "source": [
        "n = 10\n",
        "a, b = 0, 1\n",
        "result = []\n",
        "for _ in range(n):\n",
        "    result.append(a)\n",
        "    next_num = a + b\n",
        "    a = b\n",
        "    b = next_num\n",
        "print(' '.join(map(str, result)))"
      ]
    }
